<?xml version="1.0" encoding="utf-8"?>
<!-- The activity's content view is already a full-screen FrameLayout, so these views go straight into it -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activities.PauseActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/background_0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- The spaces share the leftover height in the same proportions as the 2016 layout -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:background="@drawable/title_border"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="@string/title_paused"
            android:textColor="@color/text_light"
            android:textSize="50sp"
            tools:fontFamily="@font/noto_sans_black" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.35" />

        <TextView
            android:id="@+id/playText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/playButton"
            android:text="@string/pause_play"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/text_light"
            tools:fontFamily="@font/noto_sans_regular" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.045" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_resume"
            android:onClick="returnToGame"
            android:src="@drawable/play_button" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.105" />

        <TextView
            android:id="@+id/returnText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@id/returnButton"
            android:text="@string/pause_menu"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/text_light"
            tools:fontFamily="@font/noto_sans_regular" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.045" />

        <ImageButton
            android:id="@+id/returnButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_return_to_menu"
            android:onClick="returnToMenu"
            android:src="@drawable/return_button" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.455" />

    </LinearLayout>

</merge>
