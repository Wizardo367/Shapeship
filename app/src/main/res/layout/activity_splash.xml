<?xml version="1.0" encoding="utf-8"?>
<!-- The activity's content view is already a full-screen FrameLayout, so these views go straight into it -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activities.SplashActivity">

    <!-- Tapping anywhere goes to the menu -->
    <ImageView
        android:id="@+id/splashScreenView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/action_continue"
        android:onClick="showMenu"
        android:scaleType="centerCrop"
        android:src="@drawable/background_0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1">

        <ImageView
            android:id="@+id/shapeshipImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.7"
            android:importantForAccessibility="no"
            android:paddingBottom="75dp"
            android:scaleType="fitEnd"
            android:src="@drawable/shapeship" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.28"
            android:text="@string/title_game"
            android:textColor="@color/text_light"
            android:textSize="35sp"
            tools:fontFamily="@font/noto_sans_black" />

        <TextView
            android:id="@+id/copyrightText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_weight="0.02"
            android:paddingBottom="10dp"
            android:text="@string/copyright"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/text_light"
            tools:fontFamily="@font/noto_sans_regular" />

    </LinearLayout>

</merge>
