<?xml version="1.0" encoding="utf-8"?>
<!-- The activity's content view is already a full-screen FrameLayout, so these views go straight into it -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activities.HelpActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/background_0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="1">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/background_bar"
            android:gravity="center"
            android:text="@string/title_help"
            android:textColor="@color/text_dark"
            android:textSize="35sp"
            tools:fontFamily="@font/noto_sans_black" />

        <ImageView
            android:id="@+id/helpImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_weight="0.3"
            android:contentDescription="@string/help_tap_image"
            android:src="@drawable/single_tap" />

        <TextView
            android:id="@+id/helpTextPara1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="25dp"
            android:layout_weight="0.2"
            android:gravity="center_horizontal"
            android:text="@string/help_aim"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            tools:fontFamily="@font/noto_sans_regular" />

        <TextView
            android:id="@+id/helpTextPara2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            android:layout_weight="0.2"
            android:gravity="center_horizontal"
            android:text="@string/help_controls"
            android:textColor="@color/text_light"
            android:textSize="18sp"
            tools:fontFamily="@font/noto_sans_regular" />

        <!-- A 48 dp touch target around the 30 dp icon, which stays where it was in 2016 -->
        <ImageButton
            android:id="@+id/return_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="1dp"
            android:layout_weight="0.1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_return_to_menu"
            android:onClick="returnToMenu"
            android:paddingStart="9dp"
            android:paddingTop="8dp"
            android:paddingEnd="9dp"
            android:paddingBottom="9dp"
            android:scaleType="fitStart"
            android:src="@drawable/return_button" />

    </LinearLayout>

</merge>
